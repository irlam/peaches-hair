# Plesk Node runtime
NODE_ENV=production
PUBLIC_SITE_URL=https://peaches.hair
BOOKING_ENABLED=false

# Private salon admin login. Use a long unique password and random session secret.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Peaches Hair
SESSION_SECRET=

# Email notifications (Resend)
RESEND_API_KEY=
EMAIL_FROM=Peaches Hair <appointments@peaches.hair>
SALON_EMAIL=

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional override; keep the default unless Meta asks you to change it.
WHATSAPP_GRAPH_API_VERSION=v22.0
# Legacy fallbacks. Numbers, switches and template names are editable in admin.
ADMIN_WHATSAPP_NUMBER=
WHATSAPP_ADMIN_TEMPLATE=new_booking
WHATSAPP_CONFIRMATION_TEMPLATE=booking_confirmation
WHATSAPP_REMINDER_TEMPLATE=appointment_reminder

# Reminder endpoint (use a separate long random value)
CRON_SECRET=
